{
  // STAGING-ONLY REFERENCE. This is NOT picked up by default Wrangler or Vite.
  // DO NOT deploy this app before verifying Access policies, runtime
  // TEAM_DOMAIN, POLICY_AUD, OWNER_EMAIL, migrations and staging build.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bazarsport-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BAZARSPORT_AUTH_MODE": "cloudflare-access"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bazarsport-staging",
      "database_id": "660089ce-a295-4f89-b863-8d335d02ac69"
    }
  ]
}
